{
  "name": "blackbox-theater",
  "version": "2.1.4",
  "description": "黑箱剧场 BlackBox Theater:ComfyUI 固定工作流控制台(MiniMax H3 短剧生成)",
  "private": true,
  "license": "GPL-3.0-only",
  "main": "main.js",
  "scripts": {
    "build": "vite build --config ui/vite.config.mts",
    "dist:win": "npm run build && node scripts/prepare-win-ssh.js && electron-builder --win nsis --x64 --publish never",
    "dev:ui": "vite --config ui/vite.config.mts",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke",
    "typecheck": "tsc -p ui/tsconfig.json --noEmit",
    "test": "node --test \"test/**/*.test.js\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.itest.js\""
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "4.3.3",
    "electron": "43.7.7",
    "electron-builder": "26.18.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.160.0",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  },
  "dependencies": {
    "ssh2": "1.17.0"
  }
}
